{
    "name": "gurpals/promato-installer",
    "description": "All new packages will be installed using this installer",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "WIS"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Installer\\": "src/"
        }
    },
    "bin": [
        "install"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
