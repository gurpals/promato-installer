#!/usr/bin/env php
<?php

$paths = [
    __DIR__ . '/../../../autoload.php', // global install
    __DIR__ . '/../vendor/autoload.php', // local dev
];

foreach ($paths as $path) {
    if (file_exists($path)) {
        require $path;
        break;
    }
}
use Installer\InstallCommand;

$token = $argv[1] ?? null;
$package = $argv[2] ?? null;

if (!$token || !$package) {
    echo "Usage: promato <TOKEN> <PACKAGE>\n";
    exit(1);
}

(new InstallCommand())->handle($token, $package);